---
import type { CollectionEntry } from 'astro:content';
import { buildOptimizedImageUrl, buildOptimizedSrcSet } from '../utils/image';

interface Props {
  post: CollectionEntry<'blog'>;
  priority?: boolean;
  featured?: boolean;
}
const { post, priority = false, featured = false } = Astro.props;
const { title, description, date, cover, tags } = post.data;

const href = `/blog/${post.id.split('/').map((segment) => encodeURIComponent(segment)).join('/')}`;
const coverSrc = cover ? buildOptimizedImageUrl(cover, { width: 720, fit: 'crop' }) : '';
const coverSrcSet = cover ? buildOptimizedSrcSet(cover, [360, 540, 720, 960], 75) : '';
const dateStr = date
  ? date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const tagsAttr = JSON.stringify(tags);
---
<article class:list={['post-card', { featured, 'has-cover': Boolean(cover) }]} data-tags={tagsAttr}>
  {cover && (
    <a href={href} class="card-image-link">
      <img
        src={coverSrc || cover}
        srcset={coverSrcSet || undefined}
        sizes={featured ? "(max-width: 860px) 100vw, 50vw" : "(max-width: 860px) 100vw, 520px"}
        alt={title}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </a>
  )}
  <div class="card-body">
    {date && <time class="post-date" datetime={date.toISOString()}>{dateStr}</time>}
    <h2><a href={href}>{title}</a></h2>
    {description && <p class="post-desc">{description}</p>}
    {tags.length > 0 && (
      <div class="tags">
        {tags.map(tag => <a class="tag" href={`/search?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(50, 39, 23, 0.08);
    border-color: var(--color-accent);
  }
  .post-card.featured {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    grid-column: 1 / -1;
    min-height: 320px;
  }
  .post-card.featured:not(.has-cover) {
    display: block;
  }
  .card-image-link { display: block; }
  img {
    width: 100%;
    height: 200px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: opacity 0.2s;
  }
  .featured img {
    height: 100%;
    min-height: 320px;
    aspect-ratio: auto;
  }
  .card-image-link:hover img { opacity: 0.92; }
  .card-body { padding: 1.25rem; display: flex; flex-direction: column; }
  .featured .card-body { justify-content: center; padding: 2rem; }
  .post-date { font-size: 0.8rem; color: var(--color-text-muted); }
  h2 { margin: 0.4rem 0 0.6rem; font-size: 1.15rem; line-height: 1.5; font-weight: 600; }
  .featured h2 { font-size: 1.8rem; line-height: 1.3; letter-spacing: -0.02em; }
  h2 a { color: var(--color-text); }
  h2 a:hover { color: var(--color-accent); text-decoration: none; }
  .post-desc { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 0.75rem; line-height: 1.6; }
  .featured .post-desc { font-size: 1rem; line-height: 1.8; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .tag:hover { text-decoration: none; filter: brightness(0.98); }
  @media (max-width: 860px) {
    .post-card.featured { display: block; min-height: 0; }
    .featured img { min-height: 0; height: 240px; aspect-ratio: 16 / 10; }
    .featured .card-body { padding: 1.25rem; }
    .featured h2 { font-size: 1.35rem; }
  }
</style>
